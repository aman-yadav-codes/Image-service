# ─── Build outputs & runtime data ─────────────────────────────────────────────
node_modules/
dist/
.env
*.log
data/
temp.py

# Match any nested node_modules / dist / .env / logs
**/node_modules/
**/dist/
**/.env
**/*.log
**/data/

# Ignore runtime storage directories (MinIO data, local file uploads, etc.)
# but NOT the src/storage/ source code module.
storage/
**/storage/
!**/src/storage/
