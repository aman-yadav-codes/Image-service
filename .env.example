# ── Image Processing Service — Environment ───────────────────────────────────

# API
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
LOG_PRETTY=true

# Upload limits
MAX_FILE_SIZE_BYTES=20971520
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,image/tiff,image/avif

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# Redis
# Use "redis" when running via Docker Compose (the container service name)
# Use "localhost" when running the app natively outside Docker
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=VeryStrongPassword
REDIS_DB=0

# Storage driver: local | minio | s3
STORAGE_DRIVER=minio
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_BASE_URL=/images

# MinIO (S3-compatible object store)
# Use "minio" when running via Docker Compose
# Use "localhost" when running the app natively outside Docker
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=images
MINIO_REGION=us-east-1
# Public URL that browsers use to fetch images directly from MinIO
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Worker
WORKER_CONCURRENCY=1
JOB_MAX_RETRIES=3
JOB_BACKOFF_DELAY_MS=2000
JOB_KEEP_COMPLETED_MS=3600000
JOB_KEEP_FAILED_MS=86400000

# Worker Resource Limits
WORKER_CPU_LIMIT=1.0
WORKER_MEMORY_LIMIT=512M

# Image Presets
DISPLAY_WIDTH=1920
DISPLAY_QUALITY=82
THUMBNAIL_WIDTH=300
THUMBNAIL_HEIGHT=300
THUMBNAIL_QUALITY=75

# Safety Limits & Queue Configuration
MAX_IMAGE_PIXELS=40000000
MAX_METADATA_SIZE=1048576
QUEUE_NAME=image-processing
