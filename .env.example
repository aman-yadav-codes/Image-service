# ── Media Processing Service — Environment ───────────────────────────────────
NODE_ENV=production
PORT=4001
HOST=0.0.0.0
LOG_LEVEL=info
LOG_PRETTY=false

# Image upload limits
MAX_FILE_SIZE_BYTES=20971520
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,image/tiff,image/avif

# Video/PDF upload limits
MEDIA_MAX_FILE_SIZE_BYTES=524288000
MEDIA_ALLOWED_MIME_TYPES=video/mp4,video/webm,video/quicktime,video/x-matroska,video/mpeg,application/pdf
MEDIA_WORKER_CONCURRENCY=2
VIDEO_PRESET=veryfast

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=change-this-to-a-strong-password
REDIS_DB=0

STORAGE_DRIVER=minio
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_BASE_URL=/images

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change-this-access-key
MINIO_SECRET_KEY=change-this-secret-key-min-16-chars
MINIO_BUCKET=images
MINIO_REGION=us-east-1
MINIO_PUBLIC_ENDPOINT=http://YOUR_SERVER_IP:9000

WORKER_CONCURRENCY=2
JOB_MAX_RETRIES=3
JOB_BACKOFF_DELAY_MS=2000
JOB_KEEP_COMPLETED_MS=3600000
JOB_KEEP_FAILED_MS=86400000

WORKER_CPU_LIMIT=1.0
WORKER_MEMORY_LIMIT=512M
MEDIA_WORKER_CPU_LIMIT=2
MEDIA_WORKER_MEMORY_LIMIT=2G

THUMBNAIL_WIDTH=256
THUMBNAIL_HEIGHT=256
THUMBNAIL_QUALITY=75
DISPLAY_WIDTH=1280
DISPLAY_QUALITY=82
LARGE_WIDTH=1920
LARGE_QUALITY=85
PRINT_QUALITY=95
PRINT_FORMAT=png

MAX_IMAGE_PIXELS=40000000
MAX_METADATA_SIZE=1048576
QUEUE_NAME=image-processing

DATA_ROOT=/srv/image-service
