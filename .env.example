# ── Media Processing Service — Environment Variables ─────────────────────────
# Copy this file to .env and fill in the required values.
# Lines marked [REQUIRED] must be set before running.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
LOG_PRETTY=false

# ── Authentication (Better Auth session validation) ───────────────────────────
# URL of your main app server that runs Better Auth.
# The media service will call {AUTH_SERVER_URL}{AUTH_SESSION_ENDPOINT} to validate sessions.
# Set to empty string to DISABLE auth (dev only — never do this in production).
AUTH_SERVER_URL=http://your-main-app:4000      # [REQUIRED in production]
AUTH_SESSION_ENDPOINT=/api/auth/get-session    # Better Auth default — rarely needs changing
SESSION_COOKIE_NAME=better-auth.session_token  # Must match your Better Auth cookie name

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-this-to-a-strong-password   # [REQUIRED in production]
REDIS_DB=0

# ── Storage ───────────────────────────────────────────────────────────────────
# Use "minio" for production (S3-compatible object storage).
# Use "local" for local dev/testing only (not suitable for multi-container).
STORAGE_DRIVER=minio
STORAGE_LOCAL_PATH=./storage

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change-this-access-key            # [REQUIRED]
MINIO_SECRET_KEY=change-this-secret-key-min-16-chars  # [REQUIRED]
MINIO_BUCKET=media
MINIO_REGION=us-east-1
MINIO_PUBLIC_ENDPOINT=http://YOUR_SERVER_IP:9000   # [REQUIRED] public URL clients use

# ── BullMQ Job Queue ──────────────────────────────────────────────────────────
JOB_MAX_RETRIES=3
JOB_BACKOFF_DELAY_MS=2000
JOB_KEEP_COMPLETED_MS=3600000
JOB_KEEP_FAILED_MS=86400000

# ── Media Worker ──────────────────────────────────────────────────────────────
# Handles: images (Sharp), videos (FFmpeg), PDFs (Ghostscript), Excel (pass-through)
MEDIA_WORKER_CONCURRENCY=2
VIDEO_PRESET=veryfast           # FFmpeg preset: ultrafast|superfast|veryfast|faster|fast|medium|slow

# Worker Docker resource limits
MEDIA_WORKER_CPU_LIMIT=2
MEDIA_WORKER_MEMORY_LIMIT=2G

# ── Image Processing Presets (Sharp) ─────────────────────────────────────────
MAX_IMAGE_PIXELS=40000000       # Safety limit — reject images above this pixel count
THUMBNAIL_WIDTH=256
THUMBNAIL_HEIGHT=256
THUMBNAIL_QUALITY=75
DISPLAY_WIDTH=1280
DISPLAY_QUALITY=82
LARGE_WIDTH=1920
LARGE_QUALITY=85
PRINT_QUALITY=95
PRINT_FORMAT=jpeg               # "jpeg" or "png" for the print variant

# ── Data Root (bind-mount path on the Docker host) ────────────────────────────
DATA_ROOT=/srv/media-service
