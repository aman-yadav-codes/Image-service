{
  "name": "image-service",
  "version": "1.1.0",
  "description": "Production-ready image, video, and PDF processing API — Sharp + FFmpeg + qpdf + Ghostscript + BullMQ + Redis + MinIO",
  "main": "dist/api/server.js",
  "scripts": {
    "dev:api": "ts-node-dev --respawn --transpile-only src/api/server.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/workers/imageWorker.ts",
    "dev:media-worker": "ts-node-dev --respawn --transpile-only src/workers/mediaWorker.ts",
    "build": "tsc",
    "start:api": "node dist/api/server.js",
    "start:worker": "node dist/workers/imageWorker.js",
    "start:media-worker": "node dist/workers/mediaWorker.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bullmq": "^5.12.12",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "http-graceful-shutdown": "^3.1.13",
    "ioredis": "^5.4.1",
    "minio": "^8.0.7",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^3.3.7",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "pino-pretty": "^11.2.2",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.3",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.11",
    "@types/uuid": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  },
  "engines": { "node": ">=20.0.0" }
}
