# ──────────────────────────────────────────────────────────────────────────────
# Build Stage
# ──────────────────────────────────────────────────────────────────────────────

FROM node:20-alpine AS builder

WORKDIR /app
COPY package*.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.json ./
COPY src ./src
RUN npm run build
RUN npm prune --omit=dev

# ──────────────────────────────────────────────────────────────────────────────
# Production Stage
# ──────────────────────────────────────────────────────────────────────────────

FROM node:20-alpine AS production

# All processing toolchain:
#   Python compressor (images) -> pyvips/libvips with Pillow fallback
#   FFmpeg (video)             → ffmpeg
#   Ghostscript (pdf)          → ghostscript
# Excel files are stored as-is — no extra tools needed
RUN apk add --no-cache \
    python3 \
    py3-pillow \
    py3-pip \
    py3-cffi \
    vips \
    ffmpeg \
    ghostscript

RUN pip3 install --break-system-packages --no-cache-dir --no-deps pyvips==3.0.0

WORKDIR /app

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/src/scripts ./src/scripts
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

RUN mkdir -p /app/storage /tmp/media && \
    addgroup -g 1001 -S nodegroup && \
    adduser  -u 1001 -S nodeuser -G nodegroup && \
    chown -R nodeuser:nodegroup /app /tmp/media

USER nodeuser

CMD ["node", "dist/workers/mediaWorker.js"]
