FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.json ./
COPY src ./src
RUN npm run build
RUN npm prune --omit=dev

FROM node:20-alpine AS production
RUN apk add --no-cache ffmpeg qpdf ghostscript
WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./
RUN mkdir -p /app/storage /tmp/media && addgroup -g 1001 -S nodegroup && adduser -u 1001 -S nodeuser -G nodegroup && chown -R nodeuser:nodegroup /app /tmp/media
USER nodeuser
CMD ["node", "dist/workers/mediaWorker.js"]
