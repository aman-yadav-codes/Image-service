# ── Image Processing Service — Environment ───────────────────────────────────
#
# PORT REFERENCE — server already uses:
#   80, 443  → nginx
#   3000     → nextjs-app (production-app)
#   5432     → postgres (developmentdb)
#
# This service uses:
#   4001     → image-api  (API + /metrics endpoint)
#   9000     → minio      (S3 object store API)
#   9001     → minio      (MinIO web console)
#   6379     → redis      (bound to 127.0.0.1 only — not exposed externally)

# ─── API ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4001
HOST=0.0.0.0
LOG_LEVEL=info
LOG_PRETTY=false

# Upload limits
MAX_FILE_SIZE_BYTES=20971520
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif,image/tiff,image/avif

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# ─── Redis (internal only — bound to 127.0.0.1) ──────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=change-this-to-a-strong-password
REDIS_DB=0

# ─── Storage ─────────────────────────────────────────────────────────────────
STORAGE_DRIVER=minio
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_BASE_URL=/images

# ─── MinIO (S3-compatible object store) ──────────────────────────────────────
# Inside Docker Compose containers use service name "minio"
# Browsers / external clients use the public host/domain
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change-this-access-key
MINIO_SECRET_KEY=change-this-secret-key-min-16-chars
MINIO_BUCKET=images
MINIO_REGION=us-east-1
# Public URL browsers use to fetch images (update to your server IP or domain)
MINIO_PUBLIC_ENDPOINT=http://YOUR_SERVER_IP:9000

# ─── Worker ──────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
JOB_MAX_RETRIES=3
JOB_BACKOFF_DELAY_MS=2000
JOB_KEEP_COMPLETED_MS=3600000
JOB_KEEP_FAILED_MS=86400000

# Worker Resource Limits
WORKER_CPU_LIMIT=1.0
WORKER_MEMORY_LIMIT=512M

# ─── Image Presets ───────────────────────────────────────────────────────────
THUMBNAIL_WIDTH=256
THUMBNAIL_HEIGHT=256
THUMBNAIL_QUALITY=75

DISPLAY_WIDTH=1280
DISPLAY_QUALITY=82

LARGE_WIDTH=1920
LARGE_QUALITY=85

PRINT_QUALITY=95
PRINT_FORMAT=png

# ─── Safety Limits & Queue ───────────────────────────────────────────────────
MAX_IMAGE_PIXELS=40000000
MAX_METADATA_SIZE=1048576
QUEUE_NAME=image-processing

# ─── Persistent Storage (Ubuntu production) ──────────────────────────────────
# Run on server: sudo mkdir -p /srv/image-service/{minio,redis}
#                sudo chown -R $USER:$USER /srv/image-service
DATA_ROOT=/srv/image-service

# ─── Observability ───────────────────────────────────────────────────────────
# Prometheus metrics are exposed at: GET http://<server-ip>:4001/metrics
# Add this to your global Prometheus scrape config:
#
#   - job_name: 'image-service'
#     static_configs:
#       - targets: ['YOUR_SERVER_IP:4001']
