# Persistent Storage Root (Bind Mounted)
# On Windows (development): e.g. C:/docker-data
# On Linux (production): e.g. /srv/image-service
DATA_ROOT=C:/docker-data

# Observability Ports
GRAFANA_PORT=3200
PROMETHEUS_PORT=9090
LOKI_PORT=3100

# Observability Images
GRAFANA_IMAGE=grafana/grafana:latest
PROMETHEUS_IMAGE=prom/prometheus:latest
LOKI_IMAGE=grafana/loki:3.0.0
PROMTAIL_IMAGE=grafana/promtail:3.0.0
LOKI_CLIENT_URL=http://loki:3100/loki/api/v1/push

